{
  "name": "bondang-salim",
  "version": "0.1.0",
  "private": true,
  "description": "본당살림 - 본당 회계·결산 관리",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var AUTH_MODE:dev",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file=seed/dev-yongmeori.sql",
    "test": "node --test --disable-warning=ExperimentalWarning \"test/**/*.test.js\"",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "wrangler": "^4.147.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true
  }
}
