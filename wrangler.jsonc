{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bondang-salim",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",

  // 화면 파일. 화면(HTML)과 /auth/* 는 Worker 가 먼저 받아 로그인 여부를 확인한다.
  // css·js·그림 같은 프로그램 파일은 Worker 를 거치지 않고 바로 내려보낸다.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/css/*", "!/js/*", "!/img/*", "!/core/*", "!/vendor/*", "!/migrations/*",
      "!/manifest.webmanifest", "!/robots.txt"
    ]
  },

  // 서비스 계정 데이터베이스 (성당·사용자·로그인 세션). 아시아·태평양(apac)에 만듦
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bondang-salim-main",
      "database_id": "19e59564-19b7-41e4-a1f4-6901c5afba44",
      "migrations_dir": "src/migrations"
    },
    // 서버 자동 백업 보관 (성당별 장부 전체, 30일). 아시아·태평양(apac)
    {
      "binding": "BACKUPS",
      "database_name": "bondang-salim-backups",
      "database_id": "25707e9a-ecf9-4180-b42f-da5fc5ec7103",
      "migrations_dir": "src/backup-migrations"
    }
  ],

  // 매일 새벽 3시(한국) = UTC 18:00 서버 자동 백업
  "triggers": { "crons": ["0 18 * * *"] },

  // 성당별 장부 저장소: 성당 하나에 Durable Object 하나 (각자 SQLite 데이터베이스를 가진다)
  "durable_objects": {
    "bindings": [{ "name": "LEDGER", "class_name": "Ledger" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Ledger"] }
  ],

  // 장부 표 구조 파일(public/migrations/*.sql)을 서버 코드에 글자로 넣는다
  "rules": [
    { "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }
  ],

  // 구글 로그인
  //   GOOGLE_CLIENT_ID     : 구글 클라우드 콘솔의 OAuth 클라이언트 ID (공개값)
  //   GOOGLE_CLIENT_SECRET : 같은 곳의 클라이언트 보안 비밀 → `npx wrangler secret put GOOGLE_CLIENT_SECRET` 로 등록
  // 내 컴퓨터에서 시험할 때는 .dev.vars 에 GOOGLE_CLIENT_SECRET, DEV_LOGIN=1 을 둔다 (.gitignore 됨)
  "vars": {
    "GOOGLE_CLIENT_ID": "330934540745-k6jdq4ffa9ruqb0m90tci01b80kbd812.apps.googleusercontent.com"
  },

  // 버전별 미리보기 주소를 만들지 않는다 (접속 주소는 하나만)
  "preview_urls": false,

  "observability": { "enabled": true }
}
