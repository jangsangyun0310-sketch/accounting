{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bondang-salim",
  "compatibility_date": "2026-10-01",

  // 프로그램 파일(public/)만 내려보낸다. 서버 코드·데이터베이스는 없다.
  // 장부는 각 성당 컴퓨터의 파일(.bondang)에 저장되고, 계산·저장은 브라우저 안에서 한다.
  "assets": {
    "directory": "./public"
  },

  // 버전별 미리보기 주소를 만들지 않는다 (접속 주소는 하나만)
  "preview_urls": false
}
